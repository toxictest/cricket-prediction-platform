# ==============================================================================
# Cricket Prediction Community Platform — Environment Variables
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) and fill in real values.
#   cp .env.example .env.local
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# User model + relations live in `prisma/schema.prisma`.
# Local developer setup example:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cricket_platform?schema=public"

# Shadow database — ONLY needed by `prisma migrate dev` in development.
# It is created and dropped automatically by Prisma. Not required on Vercel.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cricket_platform_shadow?schema=public"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS
# ------------------------------------------------------------------------------
# Generate a strong secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Canonical origin of the site. MUST match the OAuth redirect exactly.
#   Local:      http://localhost:3000
#   Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# The public origin used to build absolute links (referral links, QR codes)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH — https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
# Google is the ONLY sign-in method. There is no email/password fallback and
# no demo/bypass channel, so with these two values unset nobody can sign in or
# register at all — the auth screens say so explicitly.
#
# Create an "OAuth client ID" of type "Web application", then add the
# Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3b. MOBILE APP (React Native / Expo)
# ------------------------------------------------------------------------------
# Nothing here is needed by the web product. `POST /api/auth/mobile` answers 503
# AUTH_NOT_CONFIGURED as soon as the signing secret below is missing, and again — for
# the idToken/accessToken paths only — when no client id below is set. The browser
# handoff the Expo app uses needs no client id here, only the web sign-in does.

# Signs the 30-day member bearer token the phone carries. NEXTAUTH_SECRET is used
# when this is unset — it already guards the same identity, so requiring a second
# variable is how a deployment ends up signing mobile tokens with a README value.
# Set your own once you care about rotating one without the other.
MEMBER_TOKEN_SECRET=""

# The Android/iOS Google client id, if you use a native Google SDK. A native build
# gets an ID token addressed to *that* id, and trusting only GOOGLE_CLIENT_ID is
# the usual reason "Google works in the browser and 401s in the app". The browser
# handoff flow (the app opens /mobile/start) does not read this at all — Google's
# client id/secret above are what that flow's sign-in page needs.
GOOGLE_MOBILE_CLIENT_ID=""

# ------------------------------------------------------------------------------
# 4. APPLICATION BEHAVIOUR
# ------------------------------------------------------------------------------
# Direct static URL of the APK. When set, the Download Center button points at
# this URL instead of the guarded /api/download route.
#   /api/download  -> authenticated + logged (recommended, default)
#   http://localhost:3000/downloads/app-release.apk -> literal static file
NEXT_PUBLIC_APK_DOWNLOAD_URL=""

# Max upload/download guard: APK filename served from /api/download
APK_FILE_NAME="app-release.apk"
APK_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 5. REFERRAL PROGRAMME
# ------------------------------------------------------------------------------
REFERRAL_CODE_LENGTH="8"
REFERRAL_CODE_PREFIX="CRC"

# ------------------------------------------------------------------------------
# 6. CONTACT ADDRESSES
# ------------------------------------------------------------------------------
# Published on /contact, /terms, /privacy, /responsible-play and the footer.
#
# There is NO default. Leaving these unset renders an explicit
# "email not configured" state instead of a fake address — `example.com` is a
# reserved domain, so mail sent to it is silently discarded while the page still
# looks like a live support channel.
#
# NEXT_PUBLIC_ is correct here: these values are rendered into public HTML.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Falls back to NEXT_PUBLIC_CONTACT_EMAIL when unset.
NEXT_PUBLIC_SECURITY_EMAIL=""

# ------------------------------------------------------------------------------
# 7. ADMIN BACK-OFFICE
# ------------------------------------------------------------------------------
# The back-office UI is at /admin: sign-in, dashboard, and the deposit-claim
# review queue. It uses these same credentials — no separate UI secret — and is
# guarded by this cookie session, not by the member middleware.
#
# Signs the admin session JWT (HS256). Independent of NEXTAUTH_SECRET, so a leak
# of one does not compromise the other. Must be at least 32 characters. The app
# refuses to start admin sign-in while the value is still the "replace-me" placeholder.
# An /admin page reading a session it cannot verify shows the sign-in screen
# rather than failing the request.
#   Generate with:  openssl rand -base64 48
ADMIN_SESSION_SECRET="replace-me-with-openssl-rand-base64-48"

# Read ONCE by `npm run db:seed` (or `npm run admin:create-super` — same code) to
# create the first Super Admin. Both do nothing if any admin already exists, so
# these can stay unset after the first run. Put them in .env.local, not on the
# shell command line, so they stay out of shell history.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Development only, read by `npm run db:seed`. Set to 1 to also create the one
# test match the seed is allowed to touch (idempotent, never shown to members);
# set to live to additionally move it to LIVE and write a 0/0 scoreboard row,
# which locks prediction submissions for that match. Unset for a clean install,
# so `prisma migrate dev`/`reset` can run the seed automatically.
SEED_TEST_MATCH=""

# ------------------------------------------------------------------------------
# 8. MONEY FEATURES — READ THIS BEFORE TURNING THEM ON
# ------------------------------------------------------------------------------
# Gates every endpoint that changes a balance or asks for one to change:
#   filing a deposit claim        POST /api/payment/request
#   approving or rejecting a claim POST /api/admin/payments/:id/approve|reject
#   filing a payout request       POST /api/withdrawal/request
#   confirming or refusing a payout POST /api/admin/withdrawals/:id/approve|reject
# Read-only endpoints (the QR, both admin queues, /api/wallet, /api/withdrawal/my)
# stay available, so an operator or a member can always see what was filed — including
# a payout whose tokens are already held while this flag is off.
#
#   on   -> "true" | "1" | "on" | "yes" | "enabled"
#   off  -> "false" | "0" | "off" | "no" | "disabled" | ""
#   unset-> enabled outside production, DISABLED in production
#
# The unset default is deliberate: a production deploy stays dark until someone
# sets the value on purpose. Under India's Online Gaming Act 2025, a deposit
# made in expectation of winnings can make the whole product an "online money
# game", which is prohibited — see docs/SYSTEM_DESIGN.md section 2. Get a
# written legal opinion before setting this to true in production.
MONEY_MODE=""

# ------------------------------------------------------------------------------
# 9. MISC
# ------------------------------------------------------------------------------
NODE_ENV="development"
