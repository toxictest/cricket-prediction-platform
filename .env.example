# ==============================================================================
# Cricket Prediction Community Platform — Environment Variables
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) and fill in real values.
#   cp .env.example .env.local
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# User model + relations live in `prisma/schema.prisma`.
# Local developer setup example:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cricket_platform?schema=public"

# Shadow database — ONLY needed by `prisma migrate dev` in development.
# It is created and dropped automatically by Prisma. Not required on Vercel.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cricket_platform_shadow?schema=public"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS
# ------------------------------------------------------------------------------
# Generate a strong secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Canonical origin of the site. MUST match the OAuth redirect exactly.
#   Local:      http://localhost:3000
#   Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# The public origin used to build absolute links (referral links, QR codes)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH — https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
# Create an "OAuth client ID" of type "Web application", then add the
# Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. APPLICATION BEHAVIOUR
# ------------------------------------------------------------------------------
# Set to "true" to reveal a passwordless "Developer Access" button on /login.
# This creates a normal database-backed account through the SAME NextAuth
# credentials flow, so the whole register → dashboard → download journey is
# testable before Google OAuth credentials exist.
#
# !! MUST be "false" in production. !!
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"
DEMO_LOGIN_PASSWORD="cyber-demo-2026"

# Direct static URL of the APK. When set, the Download Center button points at
# this URL instead of the guarded /api/download route.
#   /api/download  -> authenticated + logged (recommended, default)
#   http://localhost:3000/downloads/app-release.apk -> literal static file
NEXT_PUBLIC_APK_DOWNLOAD_URL=""

# Max upload/download guard: APK filename served from /api/download
APK_FILE_NAME="app-release.apk"
APK_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 5. REFERRAL PROGRAMME
# ------------------------------------------------------------------------------
REFERRAL_CODE_LENGTH="8"
REFERRAL_CODE_PREFIX="CRC"

# ------------------------------------------------------------------------------
# 6. MISC
# ------------------------------------------------------------------------------
NODE_ENV="development"
