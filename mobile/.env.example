# ------------------------------------------------------------------
# Expo reads EXPO_PUBLIC_* at build/start time from this file. Rename to `.env`
# (or `.env.local`) and set the URL of the backend you are actually hitting.
# Nothing named this way is private: it is compiled into the app binary.
# ------------------------------------------------------------------

# The Next.js app, scheme + host, no trailing slash.
#   Android emulator  -> http://10.0.2.2:3000   (the machine running the dev server)
#   Real device       -> http://192.168.x.x:3000 (LAN IP; needs EXPO_PUBLIC_ALLOW_CLEARTEXT=1)
#   Production        -> https://your-domain.app
EXPO_PUBLIC_API_URL=http://localhost:3000

# Nothing here turns on cleartext http. Expo allows http in debug builds and blocks it
# in release ones, which is the split you want — a production build should simply be
# pointed at an https URL.

# Polling intervals, ms. Live scores refresh at 12s by default, wallet at 30s.
# EXPO_PUBLIC_SCORE_POLL_MS=12000
# EXPO_PUBLIC_WALLET_POLL_MS=30000

# A POST endpoint accepting multipart `file` that answers { "url": "https://..." }.
# Without it, a chosen screenshot is kept on the device for preview and the claim is
# filed without proof — the backend rejects any screenshot URL it does not trust, so
# the host must also be listed in its DOWNLOAD_ALLOW_HOSTS.
# EXPO_PUBLIC_UPLOAD_URL=

# Escape hatch for testing against a backend with no Google client configured.
# Prints a token with `npm run mobile:token -- <member email>` in the platform repo.
# Ignored in production builds by the server itself.
# EXPO_PUBLIC_ALLOW_DEV_TOKEN=1
